# PlexMind settings. setup.sh writes this file for you; copy it by hand only
# if you are not using setup.sh:   cp .env.example .env
#
# Plex: open the dashboard and sign in with Plex (nothing to paste here).
# API key and webhook secret: generated on first start in data/secrets.json.
# Every other setting has a default: see docs/CONFIGURATION.md.

# Your media folders on this machine
MOVIES_HOST_PATH=/path/to/Movies
TV_HOST_PATH=/path/to/TV Shows

# Folder of GGUF models, and the one to start with (file name without .gguf).
# setup.sh picks one that fits your GPU and downloads it.
LLAMA_CPP_MODELS_DIR=./models
LLAMA_CPP_MODEL_ALIAS=gemma-4-12b-it-Q5_K_M

# Languages to translate subtitles into
TARGET_LANGUAGES=zh,es-MX

# Optional: ratings and posters for recommendations (free at themoviedb.org)
TMDB_API_KEY=

TZ=UTC